# Copy to .env.local and fill in. Never commit real values.
# On Vercel, set these in Project Settings → Environment Variables.

# Enquiry emails: forms post to /api/lead, which emails each submission.
# Server-side only. Never prefix with NEXT_PUBLIC_.
#
# Zoho Mail (organisation / own-domain account):
#   SMTP_HOST  smtp.zoho.in for gYOU (tested: support@gyoudigital.com logs in here;
#              smtppro.zoho.in returns "Access Restricted" for this account).
#              Other Zoho accounts: smtppro.zoho.in / smtppro.zoho.com, or the .com
#              servers if you sign in at mail.zoho.com.
#   SMTP_PORT  465 (SSL) - or 587 (TLS) if 465 is blocked by the host.
#   SMTP_USER  the full Zoho mailbox that sends, e.g. website@gyoudigital.com.
#              Emails are sent "from" this address, so it must be a real mailbox.
#   SMTP_PASS  an app-specific password if two-factor sign-in is on (recommended):
#              accounts.zoho.in → Security → App Passwords. Otherwise the mailbox password.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where enquiries are delivered (defaults to the email in content/site.ts).
LEAD_TO_EMAIL=support@gyoudigital.com

# TEMPORARY launch override. "true" lets a production build through while the
# ONLY remaining placeholders are the legal documents (content/legal/*.mdx);
# those pages then show a "being finalised" notice. Remove once the
# adviser-approved Privacy Policy, Terms and Cookie Policy are in place.
ALLOW_PENDING_LEGAL=

# Optional: post forms to an external endpoint instead of /api/lead.
NEXT_PUBLIC_LEAD_ENDPOINT=

# Canonical site URL, used for canonical tags, Open Graph, JSON-LD and the sitemap.
NEXT_PUBLIC_SITE_URL=https://rozento.in

# Marks the live site as indexable on hosts other than Vercel. On Vercel,
# VERCEL_ENV=production is set automatically for production deployments.
# Leave empty on staging/previews so they stay noindex.
NEXT_PUBLIC_SITE_ENV=

# Google Tag Manager container ID (GTM-XXXXXXX). Empty = no tags and no cookie
# banner. GA4, Meta Pixel and Google Ads conversion tags are configured inside
# GTM (see docs/HANDOVER.md), not here.
NEXT_PUBLIC_GTM_ID=
